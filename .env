# ========================================
# INFRASTRUCTURE ENVIRONMENT VARIABLES
# ========================================
VITE_API_URL=http://localhost:8080/api





# PostgreSQL
POSTGRES_DB=renthub
POSTGRES_USER=renthub_admin
POSTGRES_PASSWORD=renthub_secret

# Redis (No auth for local dev)
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=renthub_mq
RABBITMQ_PASSWORD=renthub_mq_secret

# MinIO (S3 Compatible)
MINIO_ROOT_USER=renthub_minio
MINIO_ROOT_PASSWORD=renthub_minio_secret


# MoMo Sandbox
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=THAY_BANG_PARTNER_CODE
MOMO_ACCESS_KEY=THAY_BANG_ACCESS_KEY
MOMO_SECRET_KEY=THAY_BANG_SECRET_KEY

# URLs
MOMO_REDIRECT_URL=http://localhost:5173/payment
MOMO_IPN_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/payments/momo/ipn


